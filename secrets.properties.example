# Credentials for pingfederate_authcode_loadtest.jmx. Keep private (git-ignored, chmod 600).
# Loaded with: -q env.properties -q secrets.properties. User passwords are in users.csv, not here.
 
# Client secret for client_id (env.properties). Used only in step 3 as Authorization: Basic base64(client_id:client_secret).
# Wrong or missing: steps 1-2 pass, step 3 fails (typically 401 invalid_client). Changing client_id means changing this.
# No quotes or trailing spaces. Don't pass it with -J (visible in process list). Ask the client to rotate it after testing.
# Copy to secrets.properties, chmod 600, never commit. Loaded with: -q secrets.properties
client_secret=REPLACE_ME
#introspect_client_secret=REPLACE_ME
