<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="05c_JWT_Local_Check (client-side, no server latency)" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">
import groovy.json.JsonSlurper
import java.security.Signature

def fail = { String m -&gt; SampleResult.setSuccessful(false); SampleResult.setResponseCode('JWT_INVALID'); SampleResult.setResponseMessage(m) }
def token = vars.get('access_token')
if (token == null || token.count('.') != 2) {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCodeOK()
    SampleResult.setResponseMessage('Reference token: local JWT checks skipped')
    return
}
def dec = { String s -&gt; Base64.urlDecoder.decode(s) }
def parts = token.split('\\.')
def header, claims
try {
    def slurper = new JsonSlurper()
    header = slurper.parseText(new String(dec(parts[0]), 'UTF-8'))
    claims = slurper.parseText(new String(dec(parts[1]), 'UTF-8'))
} catch (Exception e) {
    fail("Not a parsable JWT: ${e.message}")
    return
}
def errors = []
def note = 'OK'
long now = (long) (System.currentTimeMillis() / 1000)
if (!(claims.exp instanceof Number)) errors &lt;&lt; 'exp claim missing'
else if (((Number) claims.exp).longValue() &lt;= now) errors &lt;&lt; 'token already expired'
def expectedIss = props.getProperty('expected_issuer')
if (expectedIss &amp;&amp; claims.iss != expectedIss) errors &lt;&lt; "iss mismatch: ${claims.iss}"

if (props.getProperty('jwt_verify_signature') != 'false') {
    def jcaAlgs = [RS256: 'SHA256withRSA', RS384: 'SHA384withRSA', RS512: 'SHA512withRSA']
    def jca = jcaAlgs[header.alg]
    def keys = props.get('jwks.keys')
    if (jca == null) {
        note = "signature check skipped: alg ${header.alg} not supported by this script (RSA only)"
    } else if (!keys) {
        errors &lt;&lt; 'no JWKS keys loaded in setUp'
    } else {
        def pub = header.kid ? keys[header.kid] : (keys.size() == 1 ? keys.values().first() : null)
        if (pub == null) {
            errors &lt;&lt; "kid ${header.kid} not found in JWKS"
        } else {
            def sig = Signature.getInstance(jca)
            sig.initVerify(pub)
            sig.update("${parts[0]}.${parts[1]}".getBytes('US-ASCII'))
            if (!sig.verify(dec(parts[2]))) errors &lt;&lt; 'signature invalid'
        }
    }
}
if (errors) {
    fail(errors.join('; '))
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCodeOK()
    SampleResult.setResponseMessage(note)
}
</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223Sampler><hashTree></hashTree>
</hashTree>
</hashTree>
