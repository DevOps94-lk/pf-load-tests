<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Update current tokens" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">
import groovy.json.JsonSlurper
// Track the *current* tokens: PingFederate may or may not rotate the refresh token, so only overwrite what is returned.
if (prev.getResponseCode() != '200') return
try {
    def j = new JsonSlurper().parseText(prev.getResponseDataAsString())
    if (j.access_token) {
        vars.put('access_token', j.access_token.toString())
        vars.put('at_is_jwt', String.valueOf(j.access_token.toString().count('.') == 2))
        vars.put('refreshed', 'true')
    }
    if (j.refresh_token) vars.put('refresh_token', j.refresh_token.toString())
} catch (Exception e) {
    log.warn("Refresh response not parsable: ${e.message}")
}
</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PostProcessor><hashTree></hashTree>
</hashTree>
