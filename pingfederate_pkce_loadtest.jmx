<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Init iteration: reset state, PKCE, auth headers, JSON body" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">
import groovy.json.JsonOutput
import java.security.MessageDigest
import java.security.SecureRandom

// Reset per-iteration state so a failed step never leaks the previous iteration's values.
['flow_id', 'resume_path', 'auth_code', 'access_token', 'refresh_token', 'id_token', 'at_is_jwt'].each { vars.remove(it) }
vars.put('refreshed', 'false')

// PKCE (RFC 7636): 64-char verifier from the unreserved set, S256 challenge, no padding.
def rnd = new SecureRandom()
def alphabet = (('A'..'Z') + ('a'..'z') + ('0'..'9') + ['-', '.', '_', '~'])
def randomString = { int n -&gt; (1..n).collect { alphabet[rnd.nextInt(alphabet.size())] }.join() }
def verifier = randomString(64)
def challenge = Base64.urlEncoder.withoutPadding().encodeToString(
        MessageDigest.getInstance('SHA-256').digest(verifier.getBytes('US-ASCII')))
vars.put('code_verifier', verifier)
vars.put('code_challenge', challenge)
vars.put('state', randomString(24))
vars.put('nonce', randomString(24))

// client_secret_basic headers + JSON body (JsonOutput escapes quotes/backslashes in passwords).
def basic = { String id, String secret -&gt; 'Basic ' + "${id}:${secret}".getBytes('UTF-8').encodeBase64().toString() }
vars.put('basic_auth', basic(vars.get('client_id'), vars.get('client_secret')))
vars.put('basic_auth_introspect', basic(vars.get('introspect_client_id'), vars.get('introspect_client_secret')))
vars.put('authn_body', JsonOutput.toJson([username: vars.get('username'), password: vars.get('password')]))
</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PreProcessor><hashTree></hashTree>
</hashTree>
